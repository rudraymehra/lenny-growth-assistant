# ── The Lenny Growth Assistant — configuration ─────────────────────────────
# Copy to .env and adjust. Every variable has a safe default: with no .env at
# all, the app runs fully local (Ollama) with the compose-internal database.

# ── Database ────────────────────────────────────────────────────────────────
# Compose-internal URL; only change if you point at an external Postgres.
DATABASE_URL=postgresql://lenny:lenny@postgres:5432/lenny

# ── Provider selection ──────────────────────────────────────────────────────
# auto | anthropic | local
#   auto      → anthropic when ANTHROPIC_API_KEY is set, otherwise local.
#   Resolution happens ONCE at session creation and is stamped on the session;
#   a session never silently switches provider mid-conversation.
DEFAULT_PROVIDER=auto

# ── Cloud LLM (Anthropic) ───────────────────────────────────────────────────
# Leave empty to disable the cloud provider entirely — the app still works
# end-to-end on the local provider. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Local LLM (Ollama) ──────────────────────────────────────────────────────
# host.docker.internal reaches the natively-running Ollama on the Docker host
# (recommended on macOS: native Ollama uses the Metal GPU). If you run the
# optional dockerised Ollama profile, use http://ollama:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# llama3.2:3b is the tested default for 8GB machines (no thinking mode, fast).
# Larger machines can use e.g. qwen3:8b or llama3.1:8b for better quality.
OLLAMA_MODEL=llama3.2:3b

# ── Retrieval / knowledge base ──────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TRANSCRIPTS_DIR=/data/transcripts
RETRIEVAL_TOP_K=8

# ── Behaviour / limits ──────────────────────────────────────────────────────
MODEL_TIMEOUT_S=120
MAX_CONCURRENT_AGENT_SESSIONS=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── Experimental ────────────────────────────────────────────────────────────
# Route the Claude Agent SDK at Ollama's Anthropic-compatible /v1/messages
# endpoint (Ollama >= 0.14). Verified to work, but small local models handle
# the SDK's large system prompt and tool calls poorly — see architecture.md.
EXPERIMENTAL_SDK_VIA_OLLAMA=false
